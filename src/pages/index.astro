// Indexes shown before "Show all"; the rest stay folded.
// Experience highlights cite rows below: "pub:<key>" or "pat:<key>" -> numbered superscript + in-page anchor.
const refLink = (ref: string, num: number) => {
  const [kind, key] = ref.split(":");
  if (kind === "pub") {
    const p = publications.find((x) => x.key === key)!;
    return { href: `#pub-${key}`, label: String(num), title: `${p.venue.replace(" (submitted)", "")} · ${p.title}` };
  }
  const p = patents.find((x) => x.key === key)!;
  return { href: `#pat-${key}`, label: String(num), title: `${p.id} · ${p.title}` };
};
type HighlightPart = { lead?: string; text: string; href?: string; refs?: string[] };
const highlightParts = (h: string | HighlightPart | HighlightPart[]): HighlightPart[] =>
  Array.isArray(h) ? h : [typeof h === "string" ? { text: h, refs: [] } : { refs: [], ...h }];
const numberExperience = (highlights: Array<string | HighlightPart | HighlightPart[]>) => {
  let n = 0;
  return highlights.map(highlightParts).map((parts) =>
    parts.map((h) => ({
      ...h,
      links: (h.refs ?? []).map((r) => refLink(r, ++n)),
    }))
  );
};

const SELECTED_PUBS = [0, 4, 6, 7, 8];
const SELECTED_PATENTS = [0, 2, 4];

// Split an author string so "E Kim" can be emphasized.
const splitAuthors = (s: string) => s.split(ME);
