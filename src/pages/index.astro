    <script is:inline>
      document.documentElement.classList.add("js");
      document.querySelectorAll(".fold-btn").forEach((btn) => {
        const list = document.getElementById(btn.getAttribute("aria-controls"));
        btn.addEventListener("click", () => {
          const open = list.classList.toggle("open");
          btn.setAttribute("aria-expanded", open);
          btn.textContent = open ? btn.dataset.less : btn.dataset.more;
        });
      });
      // In-page links to a paper or patent: unfold its list if the row is hidden, then scroll and flash it.
      const reveal = (hash) => {
        const row = hash && document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!row || !row.classList.contains("pub-row")) return;
        const list = row.closest(".foldable");
        if (list && !list.classList.contains("open")) {
          list.classList.add("open");
          const btn = document.querySelector(`.fold-btn[aria-controls="${list.id}"]`);
          btn.setAttribute("aria-expanded", true);
          btn.textContent = btn.dataset.less;
        }
        row.scrollIntoView({ behavior: "smooth", block: "center" });
        row.classList.remove("flash");
        void row.offsetWidth;
        row.classList.add("flash");
      };
      document.querySelectorAll("a.ref").forEach((a) => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          history.pushState(null, "", a.getAttribute("href"));
          reveal(a.getAttribute("href"));
        });
      });
      window.addEventListener("hashchange", () => reveal(location.hash));
      reveal(location.hash);
    </script>
